/**
 * Cross-validation: test vectors generated by Ada/SPARK implementation.
 * The Ada binary (test_intermediates) produced these values using
 * PRNG seeded with [0,1,...,47]. This module verifies the Cryptol
 * spec produces identical outputs.
 *
 */
module Primitive::Asymmetric::KEM::HQC::Tests::AdaCrossValidation where

import Primitive::Asymmetric::KEM::HQC::Instantiations::HQC128

// -------------------- Ada-generated test vectors (small) --------------------

ada_seed_kem  = split`{32} 0x9ef877fddbe8891c6e4e79eaf022e563defaca6b152161b9a423e8fe96a403e7
ada_seed_pke  = split`{32} 0x81313de32ad36c4779865fe66dda28aa9228818c0f3e2fa0348ef16e377d1049
ada_sigma     = split`{16} 0xd2f55cdd7665ebf10318f96adc8dc30c
ada_seed_dk   = split`{32} 0x12daf031bdc7fc592e0003a21eefa9a1019539abccc8f67075947cbfeaac98c5
ada_seed_ek   = split`{32} 0xef2b80f46f3a6437b4d869bb38bdd6004bff72bcd0ceb139b4b8d47301f4fcb1
ada_m         = split`{16} 0x74b2d352cf74c934069c9de74757f505
ada_salt      = split`{16} 0xaaf9baf4ae72c4c9b48efd574140a7bc
ada_hash_ek   = split`{32} 0xc31c33c3b2962576dd3b73c579c9e87eaa1aef5fb437f8c92e65d6670adbcdec
ada_theta     = split`{32} 0x9d48e9a9692a698cc29c3a97473f69ea9279c438d1fc28440305fd0d23f73c74
ada_K         = split`{32} 0x4fd2917248a82ba3a97f755d5fd823aa4a7f435413639d02ab75c06923e5b603
ada_ss        = split`{32} 0x4fd2917248a82ba3a97f755d5fd823aa4a7f435413639d02ab75c06923e5b603

// First and last 32 bytes of pk, sk, ct for fast partial checks
ada_pk_head = split`{32} 0xef2b80f46f3a6437b4d869bb38bdd6004bff72bcd0ceb139b4b8d47301f4fcb1
ada_pk_tail = split`{32} 0x82fd229838372fece5be08fac76748d325ef49e741708cd8bbd6b8d856e9e415
ada_sk_tail = split`{32} 0x9ef877fddbe8891c6e4e79eaf022e563defaca6b152161b9a423e8fe96a403e7
ada_ct_head = split`{32} 0x168cd045f5bdce404cdf16d5f9881726a228a9d0ba116e4f2de7053e41063758
ada_ct_tail = split`{32} 0x7a1250eb177a11f94b3d0a9306d1aa06aaf9baf4ae72c4c9b48efd574140a7bc

// -------------------- Cross-validation properties --------------------

/**
 * Verify seed derivation matches Ada output.
 * ```repl
 * :prove ada_seeds_match
 * ```
 */
property ada_seeds_match = seed_pke_ok /\ sigma_ok /\ seed_dk_ok /\ seed_ek_ok where
    kem_stream = XOF ada_seed_kem
    seed_pke = take`{32} kem_stream
    sigma = take`{16} (drop`{32} kem_stream)
    hash_out = I seed_pke
    seed_dk = take`{32} hash_out
    seed_ek = drop`{32} hash_out
    seed_pke_ok = seed_pke == ada_seed_pke
    sigma_ok = sigma == ada_sigma
    seed_dk_ok = seed_dk == ada_seed_dk
    seed_ek_ok = seed_ek == ada_seed_ek

/**
 * Verify H and G match Ada output.
 * ```repl
 * ada_hashes_match
 * ```
 */
ada_hashes_match = hash_ek_ok /\ theta_ok where
    (ek, _) = KeyGen ada_seed_kem
    hash_ek = H ek
    g_out = G hash_ek ada_m ada_salt
    theta = drop`{32} g_out
    hash_ek_ok = hash_ek == ada_hash_ek
    theta_ok = theta == ada_theta

/**
 * Verify KeyGen matches Ada output (pk head/tail + sk tail).
 * ```repl
 * ada_keygen_matches
 * ```
 */
ada_keygen_matches = pk_head_ok /\ pk_tail_ok /\ sk_tail_ok where
    (ek, dk) = KeyGen ada_seed_kem
    pk_head_ok = take`{32} ek == ada_pk_head
    pk_tail_ok = drop`{2209} ek == ada_pk_tail
    sk_tail_ok = drop`{2289} dk == ada_sk_tail

/**
 * Verify Encaps matches Ada output (K + ct head/tail).
 * ```repl
 * ada_encaps_matches
 * ```
 */
ada_encaps_matches = K_ok /\ ct_head_ok /\ ct_tail_ok where
    (ek, _) = KeyGen ada_seed_kem
    (K, ct) = Encaps ek ada_m ada_salt
    K_ok = K == ada_K
    ct_head_ok = take`{32} ct == ada_ct_head
    ct_tail_ok = drop`{4401} ct == ada_ct_tail

/**
 * Verify Decaps round-trip matches Ada output.
 * ```repl
 * ada_decaps_matches
 * ```
 */
ada_decaps_matches = ss == ada_ss where
    (ek, dk) = KeyGen ada_seed_kem
    (_, ct) = Encaps ek ada_m ada_salt
    ss = Decaps dk ct
